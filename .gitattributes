# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text diff=python

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.py text
*.txt text
*.md text
*.json text
*.yml text
*.yaml text
*.html text
*.css text
*.js text

# Declare files that will always have CRLF line endings on checkout.
*.bat text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.pkl binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.flv binary
*.fla binary
*.swf binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.pyc binary 